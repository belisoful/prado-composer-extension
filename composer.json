{
	"name": "pradosoft/prado-composer-extension",
	"type": "prado4-extension",
	"description": "The Base example PRADO Composer Extension",
	"keywords": [ "prado", "framework", "example", "extension"],
	"homepage": "https://github.com/pradosoft/prado-composer-extension",
	"license": "BSD-3-Clause",
	"authors": [
		{
			"name": "Brad Anderson",
			"email": "belisoful@icloud.com",
			"role": "Developer",
			"homepage": "https://github.com/belisoful"
		}
	],
	"autoload": {
		"psr-4": {
			"PradoComposerExtension\\": "src"
		}
	},
	"repositories": [
		{
			"type": "composer",
			"url": "https://asset-packagist.org"
		}
	],
	"require": {
		"php": ">=8.1.0",
		"pradosoft/prado" : "~4.3.3 || dev-prado-4.3"
	},
	"require-dev" : {
		"phpunit/phpunit" : "^10",
		"phpdocumentor/shim": "^3",
		"friendsofphp/php-cs-fixer": "^3.95",
		"phpstan/phpstan": "^2.1"
	},
	"prefer-stable": true,
	"config": {
		"platform": {
			"php": "8.1"
		},
		"allow-plugins": {
			"phpdocumentor/shim": true
		}
	},
	"support" : {
		"issues" : "https://github.com/pradosoft/prado-composer-extension/issues",
		"source" : "https://github.com/pradosoft/prado-composer-extension"
	},
	"scripts": {
		"fix": "vendor/bin/php-cs-fixer fix",
		"stan": "vendor/bin/phpstan analyse --memory-limit=512M",
		"unittest": "vendor/bin/phpunit --testsuite unit",
		"fulltest": [
			"@fix",
			"@stan",
			"@unittest"
		]
	},
	"extra": {
		"bootstrap": "PradoComposerExtension\\MainModule"
	}
}
